{
  "name": "shifu-me",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build && pnpm --filter @shifu/shared typecheck",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm test:api && pnpm test:web",
    "test:api": "pnpm --filter @shifu/api test",
    "test:web": "pnpm --filter @shifu/web test",
    "check": "pnpm lint && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}
