{
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit", // Appliquer automatiquement toutes les corrections disponibles de Biome
    "source.organizeImports.biome": "explicit" // Organiser automatiquement les imports avec Biome
  },
  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true // Marquer le fichier généré comme en lecture seule
  },
  "search.exclude": {
    "**/routeTree.gen.ts": true // Exclure le fichier généré de la recherche
  }
}
